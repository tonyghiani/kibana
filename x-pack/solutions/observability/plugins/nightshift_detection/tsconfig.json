    "@kbn/es-errors",
    "@kbn/es-mappings",
    "@kbn/licensing-plugin",
    "@kbn/nightshift-shared",
    "@kbn/nightshift-sources-plugin",
    "@kbn/setup-node-env",
    "@kbn/spaces-plugin",
